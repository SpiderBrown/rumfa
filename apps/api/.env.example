NODE_ENV=development
PORT=3000
CORS_ORIGINS=*                 # * = any site; or a list: https://room.alawa.ng,https://room.clientb.ng

# PostgreSQL
# Supabase: paste the "Session pooler" connection string (Supabase → Project → Connect).
# When DATABASE_URL is set, DB_HOST/PORT/USER/PASSWORD/NAME are ignored and SSL is on by default.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase's pooler allows 15 connections in session mode, shared by the API (this), the worker (WORKER_DB_POOL_MAX,
# default 4) and the live-updates feed (1). Keep the total under the limit.
DB_POOL_MAX=8
WORKER_DB_POOL_MAX=4
# For election day: put the API on Supabase's TRANSACTION pooler (same address, port 6543), where hundreds of
# connections share the database's pool, and keep a session-mode address for the live feed and the worker:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_SESSION_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_POOL_MAX=30
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rumfa
# DB_SSL=false
DB_RUN_MIGRATIONS=true         # apply pending db/migrations/*.sql on start

# Sign-in
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900   # 15 minutes
REFRESH_TOKEN_TTL_DAYS=30
OTP_MODE=sms                   # sms | console (code printed in the log) | fixed (FIXED_OTP); console/fixed refused in production
FIXED_OTP=123456
TOTP_ISSUER=Rumfa

# Africa's Talking (SMS codes and notifications)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_VOICE_NUMBER=               # voice number for bridged calls and outreach

# WhatsApp Cloud API (codes by WhatsApp; template with one body parameter)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_CODE_TEMPLATE=rumfa_code

WHATSAPP_APP_SECRET=           # checks X-Hub-Signature-256 on WhatsApp webhooks
WHATSAPP_VERIFY_TOKEN=
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
LIVEKIT_URL=                   # live video and free app calls, e.g. wss://your-livekit-host (self-hosted or LiveKit Cloud)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Files: private Supabase Storage buckets, used only by this API (apps get short-lived signed links)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=     # server only; never put it in an app
# STORAGE_DRIVER=local         # development: files under STORAGE_DIR instead of Supabase
# STORAGE_DIR=.storage
# Buckets kept on this computer even with Supabase storage (e.g. large IReV sheets on a weak connection).
# Files go under STORAGE_DIR; data/ at the repository root is not tracked by git.
# STORAGE_LOCAL_BUCKETS=irev
# STORAGE_DIR=../../data/storage
API_PUBLIC_URL=http://localhost:3000   # how providers and phones reach this API

# Webhooks: every provider callback URL carries ?key=WEBHOOK_KEY
WEBHOOK_KEY=replace-with-a-long-random-string

# ---- Worker (node dist/worker.main; same .env) ----
TICK_SECONDS=20                # case and callback deadlines
IREV_RPS=1.5                   # unofficial IReV API: keep the rate low
IREV_DOWNLOAD_RPS=5
IREV_MAX_WIDTH=1024
OCR_PROVIDER=manual            # manual (everything to the review queue) | google | azure
GOOGLE_VISION_API_KEY=
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
OCR_MIN_CONFIDENCE=0.85
FCM_PROJECT_ID=                # push notifications (Firebase service account)
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# LIVE_UPDATES=off             # API only: disable the Postgres change feed (not for production)
