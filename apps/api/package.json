{
  "name": "@rumfa/api",
  "version": "0.1.0",
  "description": "Rumfa API (NestJS): the only entry point for the apps; Supabase is used as the Postgres host",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "../../scripts/sync-shared.sh",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node --env-file-if-exists=.env dist/main",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "start:worker": "node --env-file-if-exists=.env dist/worker.main",
    "start:worker:dev": "nest start --entryFile worker.main --watch",
    "import:geography": "node --env-file-if-exists=.env dist/scripts/import-geography",
    "import:inec-contacts": "node --env-file-if-exists=.env dist/scripts/import-inec-contacts",
    "import:liaison": "node --env-file-if-exists=.env dist/scripts/import-liaison-contacts",
    "import:people": "node --env-file-if-exists=.env dist/scripts/import-people",
    "build:sample": "node --env-file-if-exists=.env dist/scripts/build-sample"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/platform-socket.io": "^11.2.10",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.10",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
