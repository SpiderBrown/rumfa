# Worker settings (load with: node --env-file=.env src/main.ts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
WEBHOOK_KEY=same-as-edge-functions

# IReV (unofficial API; keep the rate low)
IREV_RPS=1.5
IREV_DOWNLOAD_RPS=5
IREV_MAX_WIDTH=1024

# OCR: manual (everything to review queue) | google | azure
OCR_PROVIDER=manual
GOOGLE_VISION_API_KEY=
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
OCR_MIN_CONFIDENCE=0.85

# Africa's Talking (SMS, voice, airtime fallback)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_VOICE_NUMBER=

# Push notifications (Firebase service account)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# WhatsApp Cloud API (notifications only)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# VTpass (airtime and data top-ups); sandbox until go-live
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=

TICK_SECONDS=20
